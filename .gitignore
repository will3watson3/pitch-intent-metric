# Public repository allowlist. Everything else remains available locally.
/*
!/.gitignore
!/.env.example
!/README.md
!/requirements.txt
!/requirements-core.txt
!/.github/
!/docs/
!/examples/
!/scripts/
!/labeler/
!/dashboard/
!/frame-review/
!/target-audit/
!/intent-audit/
!/data/
!/reports/
!/models/

# Raw datasets, videos, review labels, model weights, and generated reports.
/data/*
!/data/README.md
/reports/*
!/reports/README.md
/models/*
!/models/README.md

# Publish the supported pipeline and its dependencies; keep experiments local.
/scripts/*
!/scripts/README.md
!/scripts/analyze_labeled_targets.py
!/scripts/apply_calibrated_zones_to_predictions.py
!/scripts/build_autonomous_dashboard.py
!/scripts/build_autonomous_pitch_dataset.py
!/scripts/build_pitcher_dataset.py
!/scripts/build_statcast_zone_predictions.py
!/scripts/build_vision_review_queue.py
!/scripts/build_webb_sweeper_intent_pilot.py
!/scripts/cache_recovery_videos.py
!/scripts/create_additional_labeling_queues.py
!/scripts/create_labeling_queue.py
!/scripts/detect_fox_zone.py
!/scripts/detect_pitcher_leg_kick.py
!/scripts/detect_setup_frame.py
!/scripts/extract_setup_frames.py
!/scripts/fox_zone_crop.py
!/scripts/fox_zone_tracker.py
!/scripts/labeler_server.py
!/scripts/match_woo_2025_videos.py
!/scripts/recover_unverified_zones.py
!/scripts/refine_broadcast_zone.py
!/scripts/run_autonomous_pitch_pipeline.py
!/scripts/run_intent_pilot.py
!/scripts/run_roboflow_workflow.py
!/scripts/select_best_glove_frame.py
!/scripts/tests/
/scripts/tests/*
!/scripts/tests/test_frame_payload.py
!/scripts/tests/test_frame_overlay.js
!/scripts/tests/test_zone_refinement.py
!/scripts/tests/test_fox_zone_crop.py
!/scripts/tests/test_intent_synthetic.py

# Defense in depth within published folders.
__pycache__/
*.py[cod]
.DS_Store
.venv/
.cache/
node_modules/
.pnpm-store/
.env
.env.*
!.env.example
*.pem
*.key
*.mp4
*.mov
*.zip
*.task
*.pt
*.pth
*.onnx
